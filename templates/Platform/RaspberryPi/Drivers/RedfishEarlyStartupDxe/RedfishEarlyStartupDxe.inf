## @file
#  Early Redfish Startup Driver for Raspberry Pi
#
#  This driver provides early initialization of Redfish services and triggers
#  the RedfishFeatureCoreDxe startup event to ensure proper initialization
#  order in the DXE phase.
#
#  Copyright (c) 2024, Raspberry Pi Foundation. All rights reserved.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION               = 0x0001001B
  BASE_NAME                 = RedfishEarlyStartupDxe
  FILE_GUID                 = 12345678-1234-5678-9ABC-123456789012
  MODULE_TYPE               = DXE_DRIVER
  VERSION_STRING            = 1.0
  ENTRY_POINT               = RedfishEarlyStartupDxeEntryPoint

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  NetworkPkg/NetworkPkg.dec
  RedfishClientPkg/RedfishClientPkg.dec
  Platform/RaspberryPi/RaspberryPi.dec

[Sources]
  RedfishEarlyStartupDxe.h
  RedfishEarlyStartupDxe.c

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  UefiLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiRuntimeServicesTableLib
  MemoryAllocationLib
  NetLib
  PrintLib
  PcdLib

[Protocols]
  gEfiRestExServiceBindingProtocolGuid         ## PRODUCES
  gEfiRestExProtocolGuid                       ## PRODUCES

[Guids]
  gEfiEventExitBootServicesGuid                ## CONSUMES
  gEfiEndOfDxeEventGroupGuid                   ## CONSUMES
  gConfigDxeFormSetGuid                        ## PRODUCES

[Pcd]
  gEfiRedfishClientPkgTokenSpaceGuid.PcdEdkIIRedfishFeatureDriverStartupEventGuid  ## CONSUMES

[Depex]
  gEfiVariableArchProtocolGuid AND
  gEfiVariableWriteArchProtocolGuid
