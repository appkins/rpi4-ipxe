[Defines]
  INF_VERSION                    = 0x0001000b
  BASE_NAME                      = RedfishPlatformCredentialLib
  FILE_GUID                      = D4ABC842-0BDD-4EE0-A38A-B45CA663115F
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = RedfishPlatformCredentialLib

#
#  VALID_ARCHITECTURES           = IA32 X64 ARM AARCH64 RISCV64
#

[Sources]
  RedfishPlatformCredentialLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RedfishPkg/RedfishPkg.dec

[LibraryClasses]
  BaseMemoryLib
  BaseLib
  DebugLib
  MemoryAllocationLib
  UefiLib
  UefiRuntimeServicesTableLib
  PcdLib

[Pcd]
  # Platform-specific PCDs for Raspberry Pi Redfish configuration
  # These will be defined in the platform's .dec file
