[Defines]
  INF_VERSION                    = 0x0001000b
  BASE_NAME                      = RedfishPlatformHostInterfaceLib
  FILE_GUID                      = D5ECB7F2-4906-94E2-45B1-31BF4FD90122
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = RedfishPlatformHostInterfaceLib
  CONSTRUCTOR                    = RedfishPlatformHostInterfaceConstructor
  MODULE_UNI_FILE                = RedfishPlatformHostInterfaceLib.uni
#
#  VALID_ARCHITECTURES           = IA32 X64
#

[Sources]
  RedfishPlatformHostInterfaceLib.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RedfishPkg/RedfishPkg.dec
  Platform/RaspberryPi/RaspberryPi.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  UefiBootServicesTableLib
  UefiLib

[Pcd]
  gEfiRedfishPkgTokenSpaceGuid.PcdRedfishHostName                ## CONSUMED
  gEfiRedfishPkgTokenSpaceGuid.PcdRedfishServiceUuid             ## CONSUMED
  gEfiRedfishPkgTokenSpaceGuid.PcdRedfishServicePort             ## CONSUMED

[Protocols]
  gRaspberryPiFirmwareProtocolGuid          ## CONSUMES

[Depex]
  gRaspberryPiFirmwareProtocolGuid
