+#define MACB_CAPS_NEED_TSUCLK			0x00000400
+#define MACB_CAPS_QUEUE_DISABLE			0x00000800
+#define MACB_CAPS_PCS				0x01000000
+#define MACB_CAPS_HIGH_SPEED			0x02000000
+#define MACB_CAPS_CLK_HW_CHG			0x04000000
+#define MACB_CAPS_MACB_IS_EMAC			0x08000000
+#define MACB_CAPS_FIFO_MODE			0x10000000
+#define MACB_CAPS_GIGABIT_MODE_AVAILABLE	0x20000000
+#define MACB_CAPS_SG_DISABLED			0x40000000
+#define MACB_CAPS_MACB_IS_GEM			0x80000000
+
+/* Bit manipulation macros */
+#define MACB_BIT(name)					\
+	(1 << MACB_##name##_OFFSET)
+#define MACB_BF(name,value)				\
+	(((value) & ((1 << MACB_##name##_SIZE) - 1))	\
+	 << MACB_##name##_OFFSET)
+#define MACB_BFEXT(name,value)\
+	(((value) >> MACB_##name##_OFFSET)		\
+	 & ((1 << MACB_##name##_SIZE) - 1))
+#define MACB_BFINS(name,value,old)			\
+	(((old) & ~(((1 << MACB_##name##_SIZE) - 1)	\
+		    << MACB_##name##_OFFSET))		\
+	 | MACB_BF(name,value))
+
+#define GEM_BIT(name)					\
+  (1 << GEM_##name##_OFFSET)
+#define GEM_BF(name, value)				\
+  (((value) & ((1 << GEM_##name##_SIZE) - 1))	\
+  << GEM_##name##_OFFSET)
+#define GEM_BFEXT(name, value)\
+  (((value) >> GEM_##name##_OFFSET)		\
+  & ((1 << GEM_##name##_SIZE) - 1))
+#define GEM_BFINS(name, value, old)			\
+  (((old) & ~(((1 << GEM_##name##_SIZE) - 1)	\
+        << GEM_##name##_OFFSET))		\
+  | GEM_BF(name, value))
+
+#define MACB_INT_RCOMP   (1 << 1)
+#define MACB_INT_TCOMP   (1 << 3)
+
+// TODO: load from firmware, fdt or store in other header
+#define MACB_PHY_RESET_PIN 0x20
+#define MACB_DMA_BURST_LEN 0x10
+
+// NEW DEFINES
+
+#define RP1_NET_BUFFER_SIZE   2048
+#define RP1_NET_PKT_RAM_SIZE  (1024*1024)
+
+#define MACB_OP_C22_n45 (1 << 30)
+#define MACB_OP_C45_ADDR (0x0 << 28)
+#define MACB_OP_C45_WR (0x1 << 28)
+#define MACB_OP_C45_RD_POSTINC (0x2 << 28)
+#define MACB_OP_C45_RD (0x3 << 28)
+
+#define MACB_OP_C22_RD (0x2 << 28)
+#define MACB_OP_C22_WR (0x1 << 28)
+#define MACB_OP_WR10 (0x2 << 16)
+
+#define MACB_MDIO_POLL_IVAL 200
+/* 10us = time to send 1518 bytes on wire at 1gbit */
+#define MACB_TX_POLL_IVAL   12
+
+#define MACB_INT_IER_NORMAL_BITS   (MACB_BIT(RCOMP) | MACB_BIT (RXUBR) | MACB_BIT(TXUBR) | MACB_BIT(TCOMP))
+#define MACB_INT_IER_ERR_BITS (MACB_BIT(ISR_TUND) | MACB_BIT(ISR_RLE) | MACB_BIT(TXERR) | MACB_BIT(ISR_ROVR) | MACB_BIT(HRESP))
+// TODO: missing ETH_TRANSMIT_STATUS_LATE_COLLISION_OCCURRED_BITS and ETH_TRANSMIT_STATUS_RESP_NOT_OK_BITS
+#define MACB_TX_STATUS_ERR_BITS (MACB_BIT(TSR_RLE) | MACB_BIT(COL) | MACB_BIT(BEX) | MACB_BIT(UND))
+
+#define RING_BUF_SPACE(consumer, producer, size) \
+    (((consumer) <= (producer)) ? ((size) - ((producer) - (consumer)) - 1) \
+                                : ((consumer) - (producer) - 1))
+
+// Reconstructed ETH_*_OFFSET constants
+
+#define ETH_NETWORK_CONTROL_OFFSET               MACB_NCR
+#define ETH_NETWORK_CONFIG_OFFSET                MACB_NCFGR
+#define ETH_NETWORK_STATUS_OFFSET                MACB_NSR
+#define ETH_DMA_CONFIG_OFFSET                    GEM_DMACFG
+#define ETH_TRANSMIT_STATUS_OFFSET               MACB_TSR
+#define ETH_RECEIVE_STATUS_OFFSET                MACB_RSR
+#define ETH_INT_STATUS_OFFSET                    MACB_ISR
+#define ETH_INT_ENABLE_OFFSET                    MACB_IER
+#define ETH_INT_DISABLE_OFFSET                   MACB_IDR
+#define ETH_PHY_MANAGEMENT_OFFSET                MACB_MAN
+#define ETH_TX_BD_CONTROL_OFFSET                 GEM_TXBDCTRL
+#define ETH_RX_BD_CONTROL_OFFSET                 GEM_RXBDCTRL
+#define ETH_AXI_MAX_PIPELINE_OFFSET              GEM_AMP
+
+// Deskriptor-Pointer
+#define ETH_TRANSMIT_Q_PTR_OFFSET                MACB_TBQP
+#define ETH_RECEIVE_Q_PTR_OFFSET                 MACB_RBQP
+#define ETH_UPPER_TX_Q_BASE_ADDR_OFFSET          MACB_TBQPH
+#define ETH_UPPER_RX_Q_BASE_ADDR_OFFSET          MACB_RBQPH
+
+// MAC-Adresse
+#define ETH_SPEC_ADD1_BOTTOM_OFFSET              GEM_SA1B
+#define ETH_SPEC_ADD1_TOP_OFFSET                 GEM_SA1T
+
+#define GEM_RX_ADDR_LO_RING_WRAP       (1 << 1)
+#define GEM_RX_ADDR_LO_CPU_OWNS_BUF    (1 << 0)
+#define GEM_RX_ADDR_LO_ADDR_MASK       (0xfffffffc) /* must be word-aligned */
+#define GEM_RX_STATUS_LEN_MASK         ((1 << 14) - 1)
+#define GEM_RX_STATUS_SOF              (1 << 14)
+#define GEM_RX_STATUS_EOF              (1 << 15)
+#define GEM_RX_STATUS_ADDR_MATCH       ((1 << 27) | (1 << 29))
+#define GEM_RX_STATUS_BROADCAST_MATCH  (1 << 31)
+
+#define GEM_TX_STATUS_CPU_OWNS_BUF  (1 << 31)
+#define GEM_TX_STATUS_RING_WRAP     (1 << 30)
+// TODO: also use not only wrap
+#define GEM_TX_STATUS_LAST_BUF      (1 << 15)
+#define GEM_TX_STATUS_LEN_MASK      ((1 << 14) - 1)
+
+// Macb hardware expectations | each is 16 bytes
+#pragma pack(1)
+typedef struct GEM_DMA64_RX_DESC_ {
+  volatile UINT32 AddrLo;
+  volatile UINT32 Status;
+  volatile UINT32 AddrHi;
+  volatile UINT32 Pad;
+} GEM_DMA64_RX_DESC;
+
+typedef struct GEM_DMA64_TX_DESC_ {
+  volatile UINT32 AddrLo;
+  volatile UINT32 Status;
+  volatile UINT32 AddrHi;
+  volatile UINT32 Pad;
+} GEM_DMA64_TX_DESC;
+#pragma pack()
+
+// Count of descriptors 32
+#define RP1_NET_RING_DESC_COUNT 32
+// per packet buffer
+#define MACB_RX_BUFFER_SIZE     2048
+
+typedef struct
+{
+  UINT32 Signature;
+  EFI_HANDLE ControllerHandle;
+
+  EFI_LOCK Lock;
+  EFI_EVENT ExitBootServicesEvent;
+
+  EFI_SIMPLE_NETWORK_PROTOCOL Snp;
+  EFI_SIMPLE_NETWORK_MODE SnpMode;
+
+  EFI_ADAPTER_INFORMATION_PROTOCOL Aip;
+
+  RP1_ETHERNET_PLATFORM_DEVICE_PROTOCOL *Dev;
+
+  EFI_PHYSICAL_ADDRESS RegBase;
+
+  RP1_GPIO_PROTOCOL *Gpio;
+
+  //
+  // DMA Descriptors (aligned memory)
+  //
+  VOID *DescRingBase;                 // Virtual addr for all descriptors (RX+TX)
+  EFI_PHYSICAL_ADDRESS DescRingDma;   // Mapped physical addr
+  VOID *DescRingMapping;
+
+  EFI_PHYSICAL_ADDRESS   RxBufferDma;
+  VOID                  *RxBuffer;
+  VOID                  *RxBufferMapping;
+
+
+  GEM_DMA64_RX_DESC     *RxRing;
+  GEM_DMA64_TX_DESC     *TxRing;
+  UINTN RxRingSize;
+  UINTN TxRingSize;
+  EFI_PHYSICAL_ADDRESS  RxRingDma;
+  EFI_PHYSICAL_ADDRESS  TxRingDma;
+
+  // TX Producer
+  UINT32 TxIndex;
+  UINT32 RxIndex;
+
+  UINT8           *TxOriginalUserBuffer[RP1_NET_RING_DESC_COUNT];
+  VOID                    *TxBuffer;
+  VOID                    *TxBufferMapping;
+  EFI_PHYSICAL_ADDRESS     TxBufferDma;
+
+  // TX Consumer
+  UINT32                   TxCleanIndex;
+  // TxQueued is there to differenciate between
+  // consumer = producer because all buffers are used
+  // or because no buffer was used
+  UINT32                   TxQueued;
+
+  UINT32 Caps;
+  BOOLEAN CanHwCsum, CanHwDmaPtp, CanHwNtuple, CanHwDma64;
+} MACB_PRIVATE_DATA;
+
