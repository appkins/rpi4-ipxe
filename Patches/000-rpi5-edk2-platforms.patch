+BOOLEAN
+MacbRxAvailable (
+  IN MACB_PRIVATE_DATA *Macb
+  )
+{
+  UINT32 Isr;
+
+  // No clear necessary as clear-on-read
+  Isr = MacbMmioRead (Macb, MACB_ISR);
+  return (Isr & MACB_INT_RCOMP) != 0;
+}
