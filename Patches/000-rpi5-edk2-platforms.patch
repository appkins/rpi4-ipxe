+
+    form formid = 0x1000,
+        title  = STRING_TOKEN(STR_SYSTEM_TABLE_FORM_TITLE);
+
+        oneof varid = SystemTableMode.Mode,
+          prompt      = STRING_TOKEN(STR_SYSTEM_TABLE_MODE_PROMPT),
