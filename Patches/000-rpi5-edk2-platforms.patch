+#define ENSURE_CLK_ENABLED(ClkId, ClkVar) \
+  Status = Rp1IsClockEnabled (Macb->Dev->BaseAddress, ClkId, &ClkVar); \
+  ASSERT_EFI_ERROR (Status); \
+  if (!ClkVar) { \
+    Status = Rp1ClockEnable (Macb->Dev->BaseAddress, ClkId); \
+    ASSERT_EFI_ERROR (Status); \
+  }
