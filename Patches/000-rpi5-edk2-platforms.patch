+#ifndef __BCM2712_PCI_HOST_BRIDGE_H__
+#define __BCM2712_PCI_HOST_BRIDGE_H__
+
+#include <Protocol/Bcm2712PciePlatform.h>
+
+typedef struct {
+  EFI_PHYSICAL_ADDRESS    CpuBase;
+  EFI_PHYSICAL_ADDRESS    BusBase;
+  UINTN                   Size;
+} BCM_PCIE_RC_WINDOW;
+
+typedef struct {
