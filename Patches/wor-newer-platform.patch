+      __FUNCTION__, Status, Cmd->BufferHead.Response));
+    Status = EFI_DEVICE_ERROR;
+  } else {
+    *Value = Cmd->TagBody.Value;
+  }
+
+  ReleaseSpinLock (&mMailboxLock);
+
+  return Status;
