+STATIC
+VOID
+EFIAPI
+AcpiOsBootHandler (
+  IN ACPI_OS_BOOT_TYPE  OsType
+  )
+{
+  if ((mAcpiSdtProtocol == NULL) || (mDsdtTable == NULL)) {
+    ASSERT (FALSE);
+    return;
+  }
+
+  AcpiFixupPcieEcam (OsType);
+
+  AcpiUpdateChecksum ((UINT8 *)mDsdtTable, mDsdtTable->Length);
